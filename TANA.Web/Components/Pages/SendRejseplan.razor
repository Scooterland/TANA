<h3>SendRejseplan</h3>

@page "/SendRejseplan"
@rendermode InteractiveServer
@using System.IO;
@using QuestPDF.Fluent;
@using QuestPDF.Drawing;
@using QuestPDF.Infrastructure;
@using System.Net.Http.Json;
@using TANA.Application.Models;
@using TANA.Infrastructure.Services;
@inject HttpClient Http


<PageTitle>SendRejseplan</PageTitle>

<div class="form-group">
    <label>Navn:</label>
    <input class="form-control" @bind="navn" />

    <label>Email:</label>
    <input class="form-control" @bind="email" />

    <label>Rejsedestination:</label>
    <input class="form-control" @bind="destination" />

    <label>Afrejse (tidspunkt):</label>
    <input class="form-control" @bind="afrejse" />

    <label>Hjemrejse (tidspunkt):</label>
    <input class="form-control" @bind="hjemrejse" />

    <label>Flyselskab:</label>
    <input class="form-control" @bind="flyselskab" />
</div>

<button class="btn btn-primary" @onclick="GeneratePdf">Create Pdf</button>

@code {
    [Inject] IJSRuntime JS { get; set; }  // Inject JSRuntime for at åbne PDF i et nyt vindue

        private string navn, email, destination, afrejse, hjemrejse, flyselskab;

        private async Task GeneratePdf()
        {
            try
            {
                QuestPDF.Settings.License = LicenseType.Community;

                var model = new InvoiceModel
                {
                    Comments = $"Rejsedestination: {destination}\nAfrejse: {afrejse}\nHjemrejse: {hjemrejse}\nFlyselskab: {flyselskab}",
                    CustomerAddress = new Address
                    {
                        CompanyName = navn,
                        Email = email
                    },
                    Items = new List<OrderItem>() // evt. tom for nu
                };

            // Sender data til serveren
            var response = await Http.PostAsJsonAsync("https://localhost:62778/api/pdf/rejseplan", model);

                var document = new InvoiceDocument(model);
                var pdfBytes = document.GeneratePdf();

                // Konverter til base64 string
                var base64 = Convert.ToBase64String(pdfBytes);
                var pdfDataUrl = $"data:application/pdf;base64,{base64}";

                // Åbn i nyt vindue
                await JS.InvokeVoidAsync("open", pdfDataUrl, "_blank");

                // Åbn PDF'en i et nyt vindue
                await JS.InvokeVoidAsync("open", "https://localhost:62778/api/pdf/rejseplan/view", "_blank");
            }
            catch (Exception ex)
            {
                Console.WriteLine("Fejl ved PDF-generering: " + ex.Message);
            }
        }
}
