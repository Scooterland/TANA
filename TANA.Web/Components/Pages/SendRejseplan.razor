<h3>SendRejseplan</h3>

@page "/SendRejseplan"
@rendermode InteractiveServer
@using System.IO;
@using QuestPDF.Fluent;
@using QuestPDF.Drawing;
@using QuestPDF.Infrastructure;
@using System.Net.Http.Json


<PageTitle>SendRejseplan</PageTitle>

<div class="form-group">
    <label>Navn:</label>
    <input class="form-control" @bind="navn" />

    <label>Email:</label>
    <input class="form-control" @bind="email" />

    <label>Rejsedestination:</label>
    <input class="form-control" @bind="destination" />

    <label>Afrejse (tidspunkt):</label>
    <input class="form-control" @bind="afrejse" />

    <label>Hjemrejse (tidspunkt):</label>
    <input class="form-control" @bind="hjemrejse" />

    <label>Flyselskab:</label>
    <input class="form-control" @bind="flyselskab" />
</div>

<button class="btn btn-primary" @onclick="GeneratePdf">Create Pdf</button>

@code {
    [Inject] NavigationManager Navigation { get; set; }
    [Inject] HttpClient Http { get; set; }
    [Inject] IJSRuntime JS { get; set; }  // Inject JSRuntime for at åbne PDF i et nyt vindue

    private string navn, email, destination, afrejse, hjemrejse, flyselskab;
    private string apiBase;

    protected override void OnInitialized()
    {
        var uri = new Uri(Navigation.BaseUri);
        apiBase = "http://tana-api";
    }

    private async Task GeneratePdf()
    {
        var data = new
        {
            Navn = navn,
            Email = email,
            Destination = destination,
            Afrejse = afrejse,
            Hjemrejse = hjemrejse,
            Flyselskab = flyselskab
        };

        try
        {
            var response = await Http.PostAsJsonAsync($"{apiBase}/api/pdf/rejseplan", data);

            if (response.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("open", "http://localhost:5003/api/pdf/rejseplan/view", "_blank");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"PDF error: {error}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception: {ex.Message}");
        }
    }
}
