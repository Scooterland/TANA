@page "/rejseplaner"
@using TANA.Application.Interfaces
@using TANA.Application.DTOs
@inject ITravelPlanService TravelPlanService
@inject ITurService TurService
@rendermode InteractiveServer

<h3>Eksisterende Rejseplaner</h3>

@if (travelPlans.Any())
{
    @foreach (var plan in travelPlans)
    {
        <div style="border: 1px solid #ccc; padding: 1rem; margin-bottom: 1rem;">
            <h4>@plan.Navn</h4>
            <p>@plan.Description</p>
            <p><strong>Pris:</strong> @plan.Pris kr – <strong>Dage:</strong> @plan.Dage</p>
            <button @onclick="() => DeleteRejsePlan(plan.Id)">Slet</button>
            <ul>
                @foreach (var tur in plan.Ture)
                {
                    <li>@tur.Navn</li>
                }
            </ul>
        </div>
    }
}
else
{
    <p>Ingen rejseplaner oprettet endnu.</p>
}

<button @onclick="() => showModal = true">Opret Rejseplan</button>

@if (showModal)
{
    <div style="position:fixed; top:0; left:0; width:100vw; height:100vh; background-color:rgba(0,0,0,0.5)">
        <div style="background:white; width:400px; margin:100px auto; padding:20px; border-radius:10px;">
            <h4>Ny Rejseplan</h4>
            <input placeholder="Navn" @bind="navn" class="form-control mb-2" />
            <textarea placeholder="Beskrivelse" @bind="description" class="form-control mb-2"></textarea>
            <input type="number" placeholder="Pris" @bind="pris" class="form-control mb-2" />
            <input type="number" placeholder="Dage" @bind="dage" class="form-control mb-2" />

            <label>Vælg ture:</label>
            @foreach (var tur in alleTure)
            {
                <div>
                    <input type="checkbox" @bind="tur.IsSelected" />
                    @tur.Navn
                </div>
            }

            <button @onclick="SaveRejsePlan">Gem</button>
            <button @onclick="() => showModal = false">Annuller</button>
        </div>
    </div>
}

@code {
    private List<RejsePlanDto> travelPlans = new();
    private List<SelectableTurDto> alleTure = new();
    private string navn, description;
    private double pris;
    private int dage;
    private bool showModal = false;

    protected override async Task OnInitializedAsync()
    {
        await HentRejseplanerAsync();
        var ture = await TurService.GetAllTurAsync();
        alleTure = ture.Select(t => new SelectableTurDto { Id = t.Id, Navn = t.Navn }).ToList();
    }

    private async Task HentRejseplanerAsync()
    {
        travelPlans = await TravelPlanService.GetAllRejseplanerAsync();
    }

    private async Task SaveRejsePlan()
    {
        var selectedTurIds = alleTure.Where(t => t.IsSelected).Select(t => t.Id).ToList();

        await TravelPlanService.CreateTravelPlanAsync(navn, selectedTurIds, 1, description, pris, dage);
        showModal = false;

        // Clear form
        navn = description = "";
        pris = dage = 0;
        alleTure.ForEach(t => t.IsSelected = false);

        await HentRejseplanerAsync();
    }

    private async Task DeleteRejsePlan(int id)
    {
        await TravelPlanService.DeleteTravelPlanAsync(id);
        await HentRejseplanerAsync(); // Opdater listen
    }

    public class SelectableTurDto
    {
        public int Id { get; set; }
        public string Navn { get; set; }
        public bool IsSelected { get; set; }
    }
}