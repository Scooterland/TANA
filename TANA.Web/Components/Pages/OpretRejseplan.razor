@using TANA.Application.Interfaces;

@page "/opret-rejseplan"
@inject ITurService TurService
@inject ITravelPlanService TravelPlanService

<h3>Opret Rejseplan</h3>

@foreach (var tur in availableTurs)
{
    <div>
        <input type="checkbox" @bind="@tur.IsSelected" />
        <span>@tur.Navn</span>
    </div>
}

<button @onclick="CreateTravelPlan">Opret Rejseplan</button>

@code {
    List<TurViewModel> availableTurs = new();

    protected override async Task OnInitializedAsync()
    {
        var turs = await TurService.GetAllTurAsync();
        availableTurs = turs.Select(t => new TurViewModel
            {
                Id = t.Id,
                Navn = t.Navn,
                IsSelected = false
            }).ToList();
    }
    
    private int kundeId = 1; // Midlertidigt — skift dette senere til brugerens ID

    private async Task CreateTravelPlan()
    {
        var selectedTurIds = availableTurs
            .Where(t => t.IsSelected)
            .Select(t => t.Id)
            .ToList();

        // Create the travel plan by passing the selected TurIds
        await TravelPlanService.CreateTravelPlanAsync("Ny rejseplan", selectedTurIds, kundeId);
    }

    class TurViewModel
    {
        public int Id { get; set; }
        public string Navn { get; set; }
        public bool IsSelected { get; set; }
    }
}